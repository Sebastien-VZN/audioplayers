# Force text files to use LF line endings (Linux)
*.dart text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.cc text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.swift text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.toml text eol=lf
*.cmake text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.plist text eol=lf
*.xcconfig text eol=lf
*.pbxproj text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf
*.editorconfig text eol=lf
*.cfg text eol=lf
*.txt text eol=lf
*.lock text eol=lf
*.svg text eol=lf
*.podspec text eol=lf
*.rb text eol=lf
*.entitlements text eol=lf
*.xib text eol=lf
*.storyboard text eol=lf

